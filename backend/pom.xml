<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>br.com.brew</groupId>
  <artifactId>brassia-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>brassia-api</name>

  <properties>
    <java.version>25</java.version>
    <spring-modulith.version>2.1.0</spring-modulith.version>
    <!-- Jackson 2 (com.fasterxml). O Spring Boot 4 traz Jackson 3
         (tools.jackson); nosso código usa a linha 2, declarada abaixo. -->
    <jackson2.version>2.22.1</jackson2.version>
    <anthropic.version>2.54.0</anthropic.version>
  </properties>

  <repositories>
    <!-- OpenSAML (transitivo de spring-security-saml2-service-provider) é
         publicado pela Shibboleth, não no Maven Central. -->
    <repository>
      <id>shibboleth-releases</id>
      <url>https://build.shibboleth.net/maven/releases/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <!-- Jackson 2 ALINHADO PELO BOM, e não artefato a artefato.
           O `jackson2.version` governava só o `jackson-databind`; `core`, `annotations` e os `datatype`
           continuavam vindo do BOM do Spring Boot, que fixa a linha 2 numa versão própria. Ao subir só o
           databind (#138), a família ficou dividida: databind 2.22.1 com core 2.21.4 e annotations 2.21.

           A orientação do próprio Jackson é manter databind, core e annotations no mesmo minor — mistura
           entre minors é o tipo de coisa que passa na suíte inteira e falha depois, com NoSuchMethodError,
           num caminho menos exercitado.

           Importar o BOM resolve os SEIS artefatos de uma vez (core, annotations, datatype-jdk8,
           datatype-jsr310, module-kotlin) em vez de fixar cada um e esquecer o próximo que entrar
           transitivo. Vem ANTES do spring-modulith-bom porque, em dependencyManagement, o primeiro import
           que declara a versão vence — e aqui é intencional que a nossa vença a do Boot. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Jackson 2 é usado direto por 11 adapters (ObjectMapper, TypeReference)
         para ler e escrever colunas JSONB. Ele chegava só como transitivo
         `optional` do OpenSAML: compilava, mas o repackage do Boot não o
         empacotava, e o jar quebrava no boot com NoClassDefFoundError. Quem usa,
         declara. Débito registrado para migrar à linha 3 (tools.jackson), que é
         a que o Boot 4 traz. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson2.version}</version>
    </dependency>
    <!-- SDK oficial da Anthropic (AIA-001), usado só pelo adapter de saída do módulo `ai`. Não é
         `optional`: o bean do provedor é criado conforme a configuração, mas a classe do adapter é
         carregada sempre — foi exatamente esse o erro que o Jackson deu acima. Domínio e casos de uso
         não conhecem este pacote; o ModularityTest cobre isso. -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <!-- Flyway 10+ modularizou o suporte por banco: sem este módulo o
           PostgreSQL 18 falha com "Unsupported Database". -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <!-- RPT-001-A: renderização do relatório do lote em PDF. Apache 2.0, sem dependência
           transitiva de servidor gráfico, e mantida pela ASF — a licença importa aqui porque o
           documento sai da plataforma para as mãos de um cliente. -->
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-jdbc</artifactId>
    </dependency>
    <!-- DEIXOU DE SER `optional` pelo mesmo motivo do starter OAuth2 logo abaixo: enquanto o SAML era
         recusado, nada em runtime tocava OpenSAML. Agora o adaptador valida a assinatura XML da assertion
         com ele, e `optional` faz o repackage do Boot não empacotar — compila e quebra no boot. É a
         terceira vez que este projeto tropeça nisso; o comentário do Jackson registra a primeira. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-saml2-service-provider</artifactId>
    </dependency>
    <!-- DEIXOU DE SER `optional` (DEB-SEC-001).
         Enquanto a troca OIDC era recusada, nada em runtime tocava estas classes e `optional` bastava.
         Agora o adaptador usa NimbusJwtDecoder para conferir a assinatura do id_token contra o JWKS —
         e `optional` faz o repackage do Boot NÃO empacotar o jar: compila e quebra no boot com
         NoClassDefFoundError. É o mesmo erro que o comentário do Jackson, dez linhas acima, registra
         ter acontecido antes nesta base. Quem usa, declara. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-ldap</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- Exposição de métricas em /actuator/prometheus. -->
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Cliente MQTT (DEB-INT-003). Paho é a implementação de referência do protocolo e não arrasta
         framework: o assinante é um bean nosso, não um listener de container. -->
    <dependency>
      <groupId>org.eclipse.paho</groupId>
      <artifactId>org.eclipse.paho.mqttv5.client</artifactId>
      <version>1.2.5</version>
    </dependency>

    <!-- Broker real em container para o IT: o critério de remoção de DEB-INT-003 exigia entrega,
         reentrega (QoS 1) e credencial revogada — nenhuma das três se prova com dublê. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-hivemq</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Keycloak em container: o critério de remoção de DEB-SEC-001 exigia IdP DE VERDADE.
         Um dublê que devolve o que o código espera prova que o código lê o que ele mesmo escreveu;
         só um provedor real exercita JWKS, assinatura, nonce e código de uso único. -->
    <dependency>
      <groupId>com.github.dasniko</groupId>
      <artifactId>testcontainers-keycloak</artifactId>
      <version>4.3.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- Testes de integração (*IT) rodam na fase verify, separados dos
             unitários (surefire). Mantém `mvn test` rápido e sem Docker. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
